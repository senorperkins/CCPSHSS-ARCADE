{
  "name": "ccpshss-arcade",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "node tools/build-game.mjs",
    "build:all": "node tools/build-game.mjs --all",
    "build:virginia": "node tools/build-game.mjs virginia-navigator",
    "build:river": "node tools/build-game.mjs river-expedition",
    "test": "npm run test:all",
    "test:all": "npm run build:all && node --test tests/*.test.mjs games/river-expedition/tests/model.test.mjs",
    "test:virginia": "npm run build:virginia && node --test tests/model.test.mjs",
    "test:river": "npm run build:river && node --test games/river-expedition/tests/model.test.mjs",
    "test:browser:river": "npm run build:river && node games/river-expedition/tests/browser.mjs",
    "test:browser:virginia": "npm run build:virginia && node tests/browser-virginia.mjs",
    "test:browser:all": "npm run test:browser:virginia && npm run test:browser:river"
  },
  "license": "MIT"
}
